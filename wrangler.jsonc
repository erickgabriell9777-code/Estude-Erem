{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estude-erem",
  "main": "worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "EREM_ACCESS_MODE": "private",
    "SUPABASE_URL": "https://lttdlxtbjyicmakobfah.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_feDo3mNXTJpr2nPRy2tgqQ_S2R2iVcC",
    "SUPABASE_CAPTCHA_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "https://erickgabriell9777.cloudflareaccess.com",
